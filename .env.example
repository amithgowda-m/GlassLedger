# GlassLedger Environment Configuration

# PostgreSQL Configuration (ACID Financial Ledger)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=glassledger_user
POSTGRES_PASSWORD=glassledger_password
POSTGRES_DB=glassledger
POSTGRES_URI=postgresql://glassledger_user:glassledger_password@localhost:5432/glassledger
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# MongoDB Configuration (Time-series Ticks & Polymorphic Strategy Telemetry)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=glassledger

# Execution & Broker Settings
DEFAULT_BROKER=paper
DECIMAL_PLACES=4
DEFAULT_FEE_RATE=0.0005
DEFAULT_SLIPPAGE=0.01

# Logging
LOG_LEVEL=INFO
